{
  "name": "portfolio-pilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "PortfolioPilot AI - personal portfolio foundation (milestone 1)",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx --env-file-if-exists=.env src/server/main.ts",
    "start:demo": "PORTFOLIO_MODE=demo tsx --env-file-if-exists=.env src/server/main.ts",
    "check:provider": "tsx --env-file-if-exists=.env scripts/check-provider.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.7",
    "better-sqlite3": "^13.0.3",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "papaparse": "^5.7.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
