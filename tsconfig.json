{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": false, "esModuleInterop": true,
    "skipLibCheck": true, "jsx": "react-jsx", "resolveJsonModule": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node"], "noEmit": true
  },
  "include": ["src", "web/src", "tests", "scripts"]
}
