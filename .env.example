# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
PORT=3000
# live (real portfolio data) | demo (synthetic data, separate database, clearly labeled)
PORTFOLIO_MODE=live
DATA_DIR=./data

# Market data: Alpaca Basic (free). Paper-trading keys are sufficient; this app never places orders.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_FEED=iex

# Financial Modeling Prep free plan (optional, end-of-day fallback, 250 calls/day)
FMP_API_KEY=
FMP_DAILY_CALL_BUDGET=200

# alpaca | none  (demo mode always uses the synthetic provider)
PRICE_PROVIDER=alpaca
# Polling interval in seconds (clamped to 30-300; 30-60 recommended)
PRICE_REFRESH_SECONDS=45
# Use the Alpaca WebSocket stream for the largest holdings (free plan: 30 symbols, 1 connection)
ALPACA_STREAM=true
# A trade older than this is not called real-time
REALTIME_MAX_AGE_SECONDS=300
